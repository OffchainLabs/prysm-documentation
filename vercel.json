{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "docusaurus",
  "buildCommand": "npm run build && node tools/nest-under-base.mjs",
  "outputDirectory": "build",
  "installCommand": "npm ci",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/docs/:path*",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/docs/:path*.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/docs/",
      "permanent": false
    },
    {
      "source": "/prysm/docs/(.*)",
      "destination": "/docs/$1",
      "permanent": false
    },
    {
      "source": "/(docs/getting-started/?)",
      "destination": "/docs/",
      "permanent": false
    },
    {
      "source": "/(docs/advanced/beacon_node_api/?)",
      "destination": "/docs/setup/storage/",
      "permanent": false
    },
    {
